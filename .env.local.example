# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI co-pilot (server only — never prefix with NEXT_PUBLIC_)
# Create a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Analyses allowed per user per 24 hours (protects your API credit on a public demo)
AI_DAILY_LIMIT=5
